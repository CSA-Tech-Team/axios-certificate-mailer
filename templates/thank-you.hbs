{{!--
  Axios'26 registration thank-you — banner on top, two lines of copy.

  Same "Teal & Gold" look as the Proleap base layout (cream page, white card,
  one gold rule, teal accents, dark-mode flip), flattened into a single file
  because this sender supports only {{tag}} / {{{raw}}} / comments — no
  {{#> layout}}, partials or {{#if}}.

  The banner (the AXIOS'26 logo, templates/axios-banner.png) is supplied
  separately and embedded in the email:
      python -m mailqueue enqueue ... --template templates/thank-you.hbs --banner templates/axios-banner.png
  It appears wherever src="cid:banner" is used below.

  Edit the two lines of copy in the two marked cells. To greet people by name
  add e.g. "Hi {{name}}," (needs a `name` column in the CSV).
--}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>Thank you for registering in Axios'26</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap');
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; }

    @media only screen and (max-width: 620px) {
      .pl-shell   { width: 100% !important; }
      .pl-pad     { padding-left: 24px !important; padding-right: 24px !important; }
      .pl-display { font-size: 24px !important; line-height: 30px !important; }
      .pl-card    { border-radius: 20px !important; }
    }

    @media (prefers-color-scheme: dark) {
      .pl-page { background-color: #0D1117 !important; }
      .pl-card { background-color: #1B1F24 !important; }
      .pl-ink  { color: #FFFFFF !important; }
      .pl-soft { color: #8B9199 !important; }
    }
    [data-ogsc] .pl-page { background-color: #0D1117 !important; }
    [data-ogsc] .pl-card { background-color: #1B1F24 !important; }
    [data-ogsc] .pl-ink  { color: #FFFFFF !important; }
    [data-ogsc] .pl-soft { color: #8B9199 !important; }
  </style>
</head>

<body class="pl-page" style="margin:0;padding:0;background-color:#FAF6EC;">

  {{!-- Inbox preview line (shown next to the subject). --}}
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
    Thank you for registering in Axios'26.
  </div>

  <table role="presentation" class="pl-page" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FAF6EC" style="background-color:#FAF6EC;">
    <tr>
      <td align="center" style="padding:32px 12px 40px;">

        <table role="presentation" class="pl-shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">
          <tr>
            <td class="pl-card" bgcolor="#ffffff" style="background-color:#ffffff;border-radius:24px;overflow:hidden;">

              {{!-- The one gold spark: a rule capping the card. --}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td height="4" bgcolor="#F2B705"
                      style="height:4px;line-height:4px;font-size:4px;background-color:#F2B705;
                             background-image:linear-gradient(90deg,#F2B705 0%,#C48F00 55%,#0F3D3A 100%);">&nbsp;</td>
                </tr>
              </table>

              {{!-- Logo banner (transparent PNG), centred with breathing room. --}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="pl-pad" align="center" style="padding:44px 44px 8px;">
                    <img src="cid:banner" width="340" alt="Axios'26"
                         style="display:block;width:340px;max-width:100%;height:auto;margin:0 auto;border:0;outline:none;text-decoration:none;">
                  </td>
                </tr>
              </table>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="pl-pad" align="center" style="padding:28px 44px 48px;">

                    {{!-- LINE 1 --}}
                    <p class="pl-ink pl-display" style="margin:0 0 14px;font-family:'Space Grotesk','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;font-size:28px;line-height:34px;font-weight:700;color:#0D1117;">
                      Thank you for registering in Axios'26.
                    </p>

                    {{!-- LINE 2 --}}
                    <p class="pl-soft" style="margin:0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;font-size:16px;line-height:26px;color:#555B66;">
                      We're excited to have you with us. See you there!
                    </p>

                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <tr>
            <td align="center" style="padding:24px 12px 0;">
              <p class="pl-soft" style="margin:0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;font-size:11px;line-height:18px;letter-spacing:0.06em;text-transform:uppercase;color:#555B66;">
                Axios'26
              </p>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

</body>
</html>
